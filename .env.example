# Copy to .env.local for local dev (or set in your host/App Runner for prod).

# Postgres connection string.
# Local (docker compose db service):
DATABASE_URL="postgresql://k2b:k2b@localhost:5432/k2b?schema=public"

# Secret used to sign agent session JWTs. Use a long random value (>= 32 chars).
# Generate one with: openssl rand -base64 36
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Key for at-rest encryption of sensitive answers (SSN, driver's license).
# MUST be exactly 32 bytes, base64-encoded. Generate: openssl rand -base64 32
# Losing this key makes existing encrypted fields unreadable — back it up.
ENCRYPTION_KEY=""

# Optional: the renters carrier-partner quote URL surfaced on the landing page.
# Defaults to K2B's ePremium partner link if unset.
# NEXT_PUBLIC_RENTERS_URL="https://www.epremiuminsurance.com/..."

# Optional: seed the initial agent account (used by `npm run db:seed`).
SEED_AGENT_EMAIL="agent@k2binsurance.com"
SEED_AGENT_PASSWORD="change-me"
SEED_AGENT_NAME="K2B Agent"
